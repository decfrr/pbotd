#!/bin/bash
#PBS -N gpu-check
#PBS -q gpu
#PBS -l select=1:ncpus=1:mem=1gb:ngpus=1
#PBS -l walltime=00:05:00
#PBS -j oe
set -eu
printf 'job=%s allocated=%s\n' "$PBS_JOBID" "$CUDA_VISIBLE_DEVICES"
# nvidia-smi lists hardware; it does not restrict its output using CUDA_VISIBLE_DEVICES.
nvidia-smi --id="$CUDA_VISIBLE_DEVICES" --query-gpu=uuid,name --format=csv,noheader
# Run your CUDA application here; it inherits the allocated UUIDs.
